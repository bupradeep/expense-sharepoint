{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/package-solution.schema.json",
  "solution": {
    "name": "expense-client-side-solution",
    "id": "4aecb1ff-3d43-4e9c-8455-babb74d44278",
    "version": "1.0.0.0",
    "includeClientSideAssets": true,
    "skipFeatureDeployment": true,
    "developer": {
      "name": "",
      "websiteUrl": "",
      "privacyUrl": "",
      "termsOfUseUrl": "",
      "mpnId": ""
    },
    "metadata": {
      "shortDescription": {
        "default": "Expense claim"
      },
      "longDescription": {
        "default": "Expense claim"
      },
      "screenshotPaths": [],
      "videoUrl": "",
      "categories": []
    },
    "features": [
      {
        "title": "expense Feature",
        "description": "The feature that activates elements of the expense solution.",
        "id": "ba216070-4bba-4a7a-bb45-375563bffaf5",
        "version": "1.0.0.0"
      }
    ],
    // Declares that this solution needs a delegated Azure AD permission to call the Expense backend
    // API now that it validates bearer tokens. "resource" must be the display name (or app id) of
    // the backend's Azure AD app registration (the one AZURE_CLIENT_ID in the backend's .env points
    // to), and "scope" must be a scope actually exposed by that app registration under "Expose an
    // API" (a common convention is "user_impersonation" or "access_as_user" -- update this to match
    // whatever was configured). After deploying, a SharePoint/tenant admin must approve this request
    // once under SharePoint Admin Center > Advanced > API access, or getToken() calls will fail.
    "webApiPermissionRequests": [
      {
        "resource": "expense",
        "scope": "user_impersonation"
      }
    ]
  },
  "paths": {
    "zippedPackage": "solution/expense.sppkg"
  }
}
